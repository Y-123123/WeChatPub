# Copy to .env. Empty keys are intentional: no original credentials are shipped.
LLM_PROVIDER=deepseek
# Generic overrides, useful with custom endpoints. Leave blank for presets.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
# Enter a Claude model ID available to your API account.
CLAUDE_MODEL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=科研文献解读
AUTO_PUBLISH=true
NCBI_EMAIL=
NCBI_API_KEY=
IMAGE_FONT=
